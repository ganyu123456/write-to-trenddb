{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "WriteToTrendDb": "Information"
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Verbose",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "WriteToTrendDb.Configuration.PlatformJsonFormatter, WriteToTrendDb",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/logs/write-to-trenddb.log",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 30,
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },

  "TrendDb5": {
    "ConnectionString": "Type=TrendDB5;SERVER=127.0.0.1:20010;DATABASE=db01;UID=system;PWD=luculent123@,SERVER=127.0.0.1:20020;DATABASE=db02;UID=system;PWD=luculent123@",
    "PoolSize": 7,
    "WriteIntervalSeconds": 1
  },

  "Mqtt": {
    "Broker": "192.168.122.231",
    "Port": 1884,
    "ClientId": "trenddb-writer",
    "Username": "sys",
    "Password": "Luculent1!",
    "Topics": [
      "device/sis/data"
    ],
    "ChannelCapacity": 256,
    "SocketBufferSize": 1048576
  },

  "PointsFilePath": "/config/points.csv"
}
